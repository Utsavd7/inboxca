SITE_PUBLIC=false
# Optional. Where the invite form posts to (a web address that accepts a POST with the
# answers as JSON text and replies 200). Empty: the form opens an email draft instead.
NEXT_PUBLIC_INVITE_ENDPOINT=
# Optional. A Cloudflare Web Analytics token, to count visits without cookies.
# Empty: the site counts nothing and calls no other server.
NEXT_PUBLIC_CF_ANALYTICS_TOKEN=

# Optional until the file worker is running. Keep the same secret on both servers.
FILE_WORKER_URL=
FILE_WORKER_SECRET=
# Optional until InboxCA is registered with the Income Tax Department: its software ID (SW and
# 8 digits) and city go into every ITR file, on the file worker and the app. Empty: ITR drafts
# can be filled and checked, but no return file is made.
ITR_SOFTWARE_ID=
ITR_SOFTWARE_CITY=
# Optional, on the file worker only: ClamAV's clamd, which checks every file sent in for
# viruses. Empty: files are marked not checked yet. clamd's StreamMaxLength must allow 50 MB.
CLAMD_HOST=
CLAMD_PORT=
# Optional. The request header the host fills with the visitor's country (Cloudflare: CF-IPCountry),
# for the India only rule of the Remote friendly preset. Empty: the check is off.
COUNTRY_HEADER=
# Optional. Orelu's own emails (the outage email, invites naming the firm, the notice before a
# closed firm's data is deleted, and email copies of phone notifications), over Amazon SES's SMTP address:
# smtps://SMTP_USER:SMTP_PASSWORD@email-smtp.ap-south-1.amazonaws.com:465, with EMAIL_FROM_DOMAIN
# verified in SES. Either empty: no system email is sent and the admin console says it is not set up.
SYSTEM_MAIL_URL=
EMAIL_FROM_DOMAIN=
# Optional. Orelu's own Cashfree account, for plan payments, receipts and refunds: the App ID and
# Secret key from Cashfree's dashboard (Developers, API keys), and sandbox or production. Add the
# webhook address <app address>/api/webhooks/cashfree for Payments, Refunds and Subscriptions, and
# allow the app's domain for Cashfree's checkout. Either key empty: firms sign up and work with no
# payment, and Settings, Billing says payments are not set up yet.
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_ENV=sandbox
# Optional. The request header the host fills with the name or number of the visitor's internet
# provider, for the admin console's office connection view. Empty: providers show as not known.
OFFICE_PROVIDER_HEADER=

# Optional. Connect with Google, Microsoft or Zoho in Settings, Email and drive. Each stays off
# until both of its keys are set; the address and app password form works without them.
# Register the redirect address <app address>/api/oauth/gmail/callback (and outlook, zoho).
# Google: only once Google has verified the app; scopes gmail.readonly and gmail.send.
# Microsoft (work and personal accounts): User.Read, Mail.Read, Mail.Send, offline_access.
# Zoho (server based client, multi DC on): ZohoMail.accounts.READ, ZohoMail.folders.READ,
# ZohoMail.messages.READ, ZohoMail.messages.CREATE.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=

# Optional. Continue with Google and Continue with Microsoft on the sign in and sign up pages,
# through Supabase Auth (scopes openid, email, profile). Each button shows once its client ID
# is set here. The client ID and secret also go into Supabase Auth: locally the same names in
# supabase/.env (read by supabase/config.toml), in production its dashboard. Register the
# redirect address <Supabase URL>/auth/v1/callback with Google and with Microsoft.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_AZURE_CLIENT_ID=

# Optional. The firm's drive on Dropbox: the app key of InboxCA's Dropbox app (Full Dropbox; it
# signs in with PKCE, so signing in needs no secret). The app secret only checks Dropbox's change
# notices: set it and add <app address>/api/drive/dropbox under Webhooks in the Dropbox App
# Console, so changes made in the drive are seen within minutes. Empty: the nightly check only.
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=

# Optional. The firm's drive on OneDrive (work and personal accounts): InboxCA's own Microsoft app
# for the drive, not the mail app above, registered as a web app for accounts in any directory and
# personal Microsoft accounts. Delegated permissions Files.ReadWrite, User.Read, offline_access.
# Register the redirect address <app address>/api/drive/callback. It signs in with PKCE and the
# secret. Stays off until both are set. Changes made in the drive are seen by the nightly check.
MS_DRIVE_CLIENT_ID=
MS_DRIVE_CLIENT_SECRET=

# Optional until AWS KMS is set up. The outer key of every firm's keys: the KMS key's ARN
# (arn:aws:kms:ap-south-1:ACCOUNT:key/KEY_ID) and ACCESS_KEY_ID:SECRET_ACCESS_KEY of an IAM user
# that may only use that key. Empty: LOCAL_KEK is used, which is for development and tests only.
KMS_KEY_ID=
KMS_CREDENTIALS=
# Optional until Backblaze B2 is set up. Orelu's workspace bucket through B2's S3 API: the
# endpoint (https://s3.REGION.backblazeb2.com), an application key for that bucket only, and the
# bucket's name. Any empty: InboxCA keeps no safety copies, and removing a file says so.
B2_ENDPOINT=
B2_KEY_ID=
B2_APPLICATION_KEY=
B2_WORKSPACE_BUCKET=
