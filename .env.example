SITE_PUBLIC=false
# Optional. Where the invite form posts to (a web address that accepts a POST with the
# answers as JSON text and replies 200). Empty: the form opens an email draft instead.
NEXT_PUBLIC_INVITE_ENDPOINT=
# Optional. A Cloudflare Web Analytics token, to count visits without cookies.
# Empty: the site counts nothing and calls no other server.
NEXT_PUBLIC_CF_ANALYTICS_TOKEN=

# Optional until the file worker is running. Keep the same secret on both servers.
FILE_WORKER_URL=
FILE_WORKER_SECRET=
# Optional until InboxCA is registered with the Income Tax Department: its software ID (SW and
# 8 digits) and city go into every ITR file, on the file worker and the app. Empty: ITR drafts
# can be filled and checked, but no return file is made.
ITR_SOFTWARE_ID=
ITR_SOFTWARE_CITY=
# Optional. The request header the host fills with the visitor's country (Cloudflare: CF-IPCountry),
# for the India only rule of the Remote friendly preset. Empty: the check is off.
COUNTRY_HEADER=
# Optional. Orelu's own emails to firm owners (the outage email), over Amazon SES's SMTP address:
# smtps://SMTP_USER:SMTP_PASSWORD@email-smtp.ap-south-1.amazonaws.com:465, with EMAIL_FROM_DOMAIN
# verified in SES. Either empty: no system email is sent and the admin console says it is not set up.
SYSTEM_MAIL_URL=
EMAIL_FROM_DOMAIN=
# Optional. The request header the host fills with the name or number of the visitor's internet
# provider, for the admin console's office connection view. Empty: providers show as not known.
OFFICE_PROVIDER_HEADER=

# Optional. Connect with Google, Microsoft or Zoho in Settings, Email and drive. Each stays off
# until both of its keys are set; the address and app password form works without them.
# Register the redirect address <app address>/api/oauth/gmail/callback (and outlook, zoho).
# Google: only once Google has verified the app; scopes gmail.readonly and gmail.send.
# Microsoft (work and personal accounts): User.Read, Mail.Read, Mail.Send, offline_access.
# Zoho (server based client, multi DC on): ZohoMail.accounts.READ, ZohoMail.folders.READ,
# ZohoMail.messages.READ, ZohoMail.messages.CREATE.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
