{
  "name": "inboxca",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:db": "vitest run --config vitest.db.config.ts",
    "db:types": "supabase gen types typescript --local --schema public > src/db/types.ts",
    "db:env": "node scripts/local-env.mjs",
    "test:e2e": "playwright test",
    "audit:page": "node scripts/audit-page.mjs",
    "brand:social": "node scripts/generate-social.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.117.2",
    "clsx": "^2.1.1",
    "lucide-react": "^1.55.0",
    "motion": "^14.1.0",
    "next": "16.4.0",
    "pg": "8.23.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.20.5",
    "@types/pg": "8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "lighthouse": "^13.5.0",
    "supabase": "2.118.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite": "7.3.7",
    "vitest": "5.0.2"
  }
}
